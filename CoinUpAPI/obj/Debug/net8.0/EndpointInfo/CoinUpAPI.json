        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "symbol": {
            "type": "string",
            "nullable": true
          },
          "rank": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "currentPrice": {
            "type": "number",
            "format": "double"
          },
          "marketCap": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "marketCapRank": {
            "type": "integer",
            "format": "int32"
          },
          "fullyDilutedValuation": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "totalVolume": {
            "type": "number",
            "format": "double"
          },
          "high24h": {
            "type": "number",
            "format": "double"
          },
          "low24h": {
            "type": "number",
            "format": "double"
          },
          "priceChange24h": {
            "type": "number",
            "format": "double"
          },
          "priceChangePercentage24h": {
            "type": "number",
            "format": "double"
          },
          "marketCapChange24h": {
            "type": "number",
            "format": "double"
          },
          "marketCapChangePercentage24h": {
            "type": "number",
            "format": "double"
          },
          "circulatingSupply": {
            "type": "number",
            "format": "double"
          },
          "totalSupply": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxSupply": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "ath": {
            "type": "number",
            "format": "double"
          },
          "athChangePercentage": {
            "type": "number",
            "format": "double"
          },
          "athDate": {
            "type": "string",
            "format": "date-time"
          },
          "atl": {
            "type": "number",
            "format": "double"
          },
          "atlChangePercentage": {
            "type": "number",
            "format": "double"
          },
          "atlDate": {
            "type": "string",
            "format": "date-time"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "PaginatedCoinsResponse": {
        "type": "object",
        "properties": {
          "totalItems": {
            "type": "integer",
            "format": "int32"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoinsMarketDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}