flowchart TB
    subgraph API ["REST API (CoinUpAPI)"]
        subgraph Auth["AuthController (/api/auth)"]
            A1["POST /register"]
            A2["POST /login"]
        end

        subgraph Coins["CoinsController (/api/coins) [Authorize]"]
            C1["GET /?query=&page=&pageSize="]
            C2["GET /{id}"]
            C3["GET /{id}/market-chart (default 90d)"]
        end

        subgraph Wallet["WalletController (/api/wallet) [Authorize]"]
            W0["GET /"]
            W1["POST /deposit"]
            W2["POST /buy"]
            W3["POST /sell"]
            W4["GET /transactions"]
        end

        subgraph Watchlist["WatchlistController (/api/watchlist) [Authorize]"]
            WL1["GET /"]
            WL2["POST /{coinId}"]
            WL3["DELETE /{coinId}"]
        end

        subgraph Alerts["AlertsController (/api/alerts) [Authorize]"]
            AL1["GET /"]
            AL2["POST /"]
            AL3["PUT /{id}"]
            AL4["DELETE /{id}"]
        end

        subgraph Users["UsersController (/api/users) [Authorize + AdminOnly]"]
            U1["GET /"]
            U2["PUT /{userId}/is-active"]
        end

        subgraph Hosted["Hosted Services (internal)"]
            H1["AlertEvaluationHostedService (periodic)"]
        end

        subgraph Infra["Infrastructure (internal)"]
            DB[(SQL Server via EF Core)]
            Email["IEmailSender (SMTP)"]
        end
    end

    Client-->|HTTP|Auth
    Client-->|HTTP|Coins
    Client-->|HTTP|Wallet
    Client-->|HTTP|Watchlist
    Client-->|HTTP|Alerts
    AdminClient-->|HTTP|Users

    %% Background evaluator reads DB state and sends emails; it does not call controllers.
    H1-->|read alerts + coins + wallets|DB
    H1-->|send email notifications|Email

    %% Wallet operations read/write DB and may send best-effort emails.
    Wallet-->|read/write|DB
    Wallet-->|send wallet emails best effort|Email

    %% Coins endpoints read from DB tables (CoinsMarket + MarketChartDetails).
    Coins-->DB
