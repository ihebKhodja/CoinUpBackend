sequenceDiagram
    participant C as Client
    participant API as AuthController
    participant AS as AuthService
    participant PH as PasswordHasher
    participant DB as ApplicationDbContext

    C->>API: POST /api/auth/login {email,password}
    API->>AS: LoginAsync(dto)
    AS->>DB: Users.FirstOrDefault(email)
    alt user not found
        DB-->>AS: null
        AS-->>API: throw "Invalid credentials"
        API-->>C: 400 BadRequest {message}
    else user found
        DB-->>AS: user
        alt account inactive
            AS-->>API: throw "Account is inactive"
            API-->>C: 400 BadRequest {message}
        else active
            AS->>PH: VerifyHashedPassword(user.PasswordHash, password)
            alt password invalid
                PH-->>AS: Failed
                AS-->>API: throw "Invalid credentials"
                API-->>C: 400 BadRequest {message}
            else password ok
                PH-->>AS: Success
                AS->>AS: GenerateJwtToken(user)
                AS-->>API: AuthResponseDto {token,userId,username,email}
                API-->>C: 200 OK (AuthResponseDto)
            end
        end
    end
