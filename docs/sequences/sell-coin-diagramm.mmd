sequenceDiagram
    participant C as Client
    participant API as WalletController
    participant Auth as JwtFilter
    participant WS as WalletService
    participant Coin as CoinsService
    participant DB as Database

    C->>API: POST /api/wallet/sell {coinId, quantity}
    API->>Auth: validate token
    Auth-->>API: userId
    API->>Coin: GetCurrentPrice(coinId)
    Coin-->>API: price
    API->>WS: Sell(userId, coinId, quantity, price)
    WS->>DB: BeginTransaction
    WS->>DB: SELECT CoinHolding WHERE WalletId AND CoinId
    DB-->>WS: holding
    alt holding.Quantity >= quantity
        WS->>DB: UPDATE CoinHolding (reduce quantity)
        WS->>DB: INSERT WalletTransaction (Sell)
        WS->>DB: UPDATE Wallet SET Balance = Balance + proceeds
        DB-->>WS: OK
        WS->>DB: Commit
        WS-->>API: success
        API-->>C: 200 {holding, newBalance, profit}
    else not enough coins
        WS->>DB: Rollback
        WS-->>API: 400 Not enough coins
        API-->>C: 400
    end
